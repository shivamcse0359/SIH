# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (optional - leave blank to disable scan history)
MONGODB_URI=mongodb://localhost:27017/linkguard

# VirusTotal API (https://www.virustotal.com/gui/join-us)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google Safe Browsing API (https://developers.google.com/safe-browsing/v4/get-started)
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# WHOIS lookup service (https://whoisjson.com or similar provider)
WHOIS_API_KEY=your_whois_api_key_here
WHOIS_API_URL=https://api.whoisjson.com/v1

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=30
